# Copy to .env and fill in your own credentials. Never commit real keys or cookies.
API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
COOKIES_STR=your_cookies_here

LOG_LEVEL=INFO
TOGGLE_KEYWORDS=。
