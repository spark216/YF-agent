# Copy to .env and fill in your own credentials. Never commit real keys or cookies.
API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
COOKIES_STR=your_cookies_here

LOG_LEVEL=INFO
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=False
MANUAL_MODE_TIMEOUT=3600
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300
# Milliseconds, unlike the intervals above.
MESSAGE_EXPIRE_TIME=300000

# Stateful booking workflow. Redis is optional; SQLite persists all session data.
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL=1800
MAX_CONCURRENCY=4
TOOL_TIMEOUT=20
TOOL_RETRIES=2
MODEL_TIMEOUT=20
RETRIEVAL_BACKEND=bge
BGE_MODEL_PATH=BAAI/bge-m3
LLM_SLOT_EXTRACTION=true
INTENT_BACKEND=rules
LIVE_PRICE_ENABLED=false
LIVE_PRICE_HOTELS=2
